////////////////////////////////////////////////////////////////////////////////
// Filename: light.ps
////////////////////////////////////////////////////////////////////////////////
#version 400


/////////////////////
// INPUT VARIABLES //
/////////////////////
in vec3 color; 
in vec2 texCoord;
in vec3 normal;
in vec3 tang;
in vec3 binorm;

//////////////////////
// OUTPUT VARIABLES //
//////////////////////
out vec4 outputColor;


///////////////////////
// UNIFORM VARIABLES //
///////////////////////
uniform float mixValue; //numero entre 0 y 1 para hacer el mix
uniform float timer;

uniform sampler2D shaderTexture0;
uniform sampler2D shaderTexture1;
uniform sampler2D shaderTexture2;
uniform vec3 lightDirection;
uniform vec4 diffuseLightColor;


////////////////////////////////////////////////////////////////////////////////
// Pixel Shader
////////////////////////////////////////////////////////////////////////////////
void main(void)
{
	vec4 textureColor0;
	vec4 textureColor1;
	vec4 textureColor2;


	// Obtener la textura difusa o de color
	textureColor0 = texture(shaderTexture0, texCoord);
	textureColor1 = texture(shaderTexture1, texCoord);
	textureColor2 = texture(shaderTexture2, texCoord);


    // mix the two colors
    //outputColor = mix(textureColor0, textureColor1, mixValue);

	if(timer >= 0 && timer <= 1.0)
	{
		//outputColor = mix(textureColor0, textureColor1, mixValue);
		//x*(1-a)+y*a

		//outputColor = (textureColor0 * (1-mixValue) + (textureColor1 * (mixValue)));

		//Full medio dia
		outputColor = textureColor0;
	}
	else if (timer >= 1.0 && timer <= 2.0)
	{
		//Transicion atardecer
		outputColor = (textureColor0 * (2-timer) + (textureColor1 * (timer - 1)));

	}
	else if (timer >= 2.0 && timer <= 3.0)
	{
		//Transicion noche
		outputColor = (textureColor1 * (3-timer) + (textureColor2 * (timer - 2)));
	}
	else if (timer >= 3.0 && timer <= 4.0)
	{
		//Full noche
		outputColor = textureColor2;
	}
	else if (timer >= 4.0 && timer <= 5.0)
	{
		//Full noche
		outputColor = textureColor2;
	}
	else if (timer >= 5.0 && timer <= 6.0)
	{
		//Transicion amanecer
		outputColor = (textureColor2 * (6 - timer) + (textureColor1 * (timer - 5)));
	}
	else if (timer >= 6.0 && timer <= 7.0)
	{
		//Transicion medio dia
		outputColor = (textureColor1 * (7 - timer) + (textureColor0 * (timer - 6)));
	}
	else if (timer >= 7.0 && timer <= 8.0)
	{
		//Full medio dia
		outputColor = textureColor0;
	}
	else
	{
		outputColor = textureColor0;
	}

	//outputColor = outputColor + 0.1; // esto es para renderizar la combinacion de textura con colores
	//outputColor = vec4(color, 1.0f); //Esto es para solo ver los colores
	//outputColor = vec4(mixValue,mixValue,mixValue, 1.0); // Renderiza la variable mixColor como color
}